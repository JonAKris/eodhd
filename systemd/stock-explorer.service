[Unit]
Description=Stock Explorer Agent (autonomous LLM exploration -> daily newsletter)
After=network-online.target postgresql.service ollama.service
Wants=network-online.target

[Service]
Type=oneshot
User=jon
Group=jon
WorkingDirectory=/home/jon/eodhd
Environment=PYTHONUNBUFFERED=1

# Database identities come entirely from .env (config.py loads it on import):
#   PG_USER / PG_PASSWORD        -- writer role (jon)
#   PG_RO_USER / PG_RO_PASSWORD  -- read-only role (ai_agent)
# The read-only boundary is enforced in code, not by pinning the process: the
# runner does every read through db.fetch_*_ro (ro_dsn / PG_RO_USER) and makes
# exactly one write -- persisting strategy_signals -- through the writer pool
# (dsn / PG_USER). Pinning PG_USER=ai_agent here would collapse the writer pool
# onto the read-only role and silently break that persist (and the newsletter's
# strategy-picks section), so we deliberately do NOT set it.
#   PREREQUISITE: PG_RO_USER / PG_RO_PASSWORD must be set in .env. If they are
#   blank, ro_dsn falls back to the writer identity and the boundary is lost.
#
# .env also supplies OLLAMA_HOST, EXPLORATION_MODEL, ANALYSIS_MODEL, SMTP_*, etc.
# If you prefer, point at it explicitly instead of relying on WorkingDirectory:
# EnvironmentFile=/home/jon/eodhd/.env

ExecStart=/home/jon/eodhd/venv/bin/python -m explorer.runner

# Publish + email the daily newsletter right after exploration finishes.
# build_newsletter() writes newsletter_findings through the writer pool, which
# resolves to PG_USER from .env (the writer) -- no per-step override needed.
ExecStartPost=/home/jon/eodhd/venv/bin/python -m explorer.newsletter

Nice=10
TimeoutStartSec=3600

[Install]
WantedBy=multi-user.target
