# --- EODHD API ---
EODHD_API_KEY=demo

# --- Postgres: writer (ingest, refresh, vintage banking) ---
PG_HOST=msa1.sumo.computer
PG_PORT=5432
PG_DB=eodhd
PG_USER=jon
PG_PASSWORD=
PG_POOL_MAX=10

# --- Postgres: read-only (agent, explorer, dashboard) ---
PG_RO_USER=ai_agent
PG_RO_PASSWORD=

# --- Ollama (explorer) ---
OLLAMA_HOST=http://127.0.0.1:11434
EXPLORATION_MODEL=qwen3.6:35b
ANALYSIS_MODEL=qwen3.6:35b

# --- Explorer output ---
FINDINGS_DIR=./findings

# --- Morning report email ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURITY=starttls
MAIL_FROM=
MAIL_TO=

# --- Dash ---
DASH_HOST=0.0.0.0
DASH_PORT=8050
DASH_DEBUG=true